# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB (Use MongoDB Atlas replica set URI for Render production)
MONGODB_URI=mongodb://localhost:27017/pulsefit-gym
# Optional fallback for networks where Node cannot perform mongodb+srv DNS lookups.
# MONGODB_FALLBACK_HOSTS=host-00.example.mongodb.net:27017,host-01.example.mongodb.net:27017,host-02.example.mongodb.net:27017
# MONGODB_REPLICA_SET=atlas-example-shard-0

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this
JWT_REFRESH_EXPIRE=30d

# CORS
# Local development: FRONTEND_URL=http://localhost:5173,http://localhost:5174
# Production Vercel frontend:
FRONTEND_URL=https://gym-management-app-wine-ten.vercel.app

# Backend secrets only. Generate a persistent 32-byte Base64 key (BIOMETRICS.md).
# Empty keyring disables enrollment storage; startup does not generate a key.
BIOMETRIC_KEY_VERSION=v1
BIOMETRIC_ENCRYPTION_KEYS={}
# Example: {"v1":"<32-byte-base64-secret>"}
BIOMETRIC_RETAIN_IMAGES=false

# Payment gateway (optional)
PAYMENT_GATEWAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS and email (optional)
SMS_ENABLED=false
EMAIL_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Gym
GYM_NAME=Vino Fitness Studio
GYM_ADDRESS=MG Road, Bengaluru
GYM_PHONE=
GYM_EMAIL=

GYM_TIMEZONE=Asia/Kolkata
# Optional DNS override; leave unset to use system DNS.
# DNS_SERVERS=1.1.1.1,8.8.8.8

BIOMETRIC_COOLDOWN_SECONDS=60
BIOMETRIC_REARM_SECONDS=5
BIOMETRIC_STALE_SESSION_HOURS=16
# review: require authorized manual review/checkout for stale visits.
# allow_checkout: close after trusted identification and retain an audit flag.
BIOMETRIC_STALE_SESSION_POLICY=review
GYM_BRANCH_ID=main

# Biometric identification mode:
# - 'kiosk-assisted' (Recommended for Render cloud deployment: workstation compares templates with local Mantra MorFinAuth)
# - 'morfin-local-development' (For local Windows PC development where backend runs on localhost)
# - 'disabled' (Turns off automatic fingerprint matching)
BIOMETRIC_IDENTIFICATION_MODE=kiosk-assisted
MORFIN_AUTH_SERVICE_URL=https://localhost:8030/morfinauth
BIOMETRIC_SEARCH_MAX_CANDIDATES=100
BIOMETRIC_SEARCH_TIMEOUT_MS=15000
