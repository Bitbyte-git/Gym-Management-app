{
  "name": "pulsefit-gym-management",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite client",
    "build": "vite build client",
    "preview": "vite preview client",
    "test": "node --test server/tests/*.test.js",
    "seed": "node server/seed.js",
    "admin:create": "node server/bootstrapAdmin.js",
    "db:indexes": "node server/createIndexes.js",
    "test:e2e": "node server/tests/browser.cjs",
    "server:dev": "node --watch server/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "latest",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "recharts": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "mongodb-memory-server": "^11.3.0"
  }
}
