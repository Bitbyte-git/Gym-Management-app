# ===================================================
# Multi-Stage Dockerfile for Vino Fitness API Server
# ===================================================

# Stage 1: Dependencies & Builder
FROM node:20-alpine AS builder
WORKDIR /app

# Install native compilation dependencies for crypto/pdf libraries
RUN apk add --no-cache python3 make g++

COPY package*.json ./
RUN npm ci --only=production --ignore-scripts

# Stage 2: Minimal Production Image
FROM node:20-alpine AS runner
WORKDIR /app

# Add dumb-init for robust PID 1 signal forwarding & zombie reaping
RUN apk add --no-cache dumb-init curl

ENV NODE_ENV=production
ENV PORT=5000

# Copy node_modules from builder
COPY --from=builder /app/node_modules ./node_modules
COPY package*.json ./
COPY server ./server

# Run as non-root unprivileged node user
USER node

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:${PORT:-5000}/api/health || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "server/index.js"]
